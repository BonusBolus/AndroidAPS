<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: the top of widget_status.xml with sample values. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        style="@style/WidgetStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.85"
        android:text="@string/widget_status_preview_header"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/WidgetStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_status_preview_bg"
            android:textColor="#FF66BB6A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_status_preview_delta"
                android:textSize="14sp" />

            <TextView
                style="@style/WidgetStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:text="@string/widget_status_preview_age"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_status_preview_iob_cob"
                android:textColor="#FF67DFE8"
                android:textSize="14sp" />

            <TextView
                style="@style/WidgetStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_status_preview_smb"
                android:textColor="#FF67DFE8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_status_preview_graph" />
</merge>
