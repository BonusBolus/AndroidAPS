<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview of the simple status widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_status_background"
        android:tint="#FF000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <include layout="@layout/widget_status_preview_body" />

        <TextView
            style="@style/WidgetStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_status_preview_values_simple"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
